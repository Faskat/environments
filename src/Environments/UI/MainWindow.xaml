<Window x:Class="Environments.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Environments.UI"
        Title="Environments" Width="1120" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" Style="{StaticResource WindowBase}"
        Icon="/Assets/app.ico">
    <Window.Resources>
        <ui:HexToBrushConverter x:Key="HexBrush" />
        <ui:NullToCollapsedConverter x:Key="NullCollapsed" />
        <ui:NullToCollapsedConverter x:Key="NotNullCollapsed" Invert="True" />
        <BooleanToVisibilityConverter x:Key="BoolVis" />

        <!-- Icon cell: real exe icon when known, line icon otherwise -->
        <DataTemplate x:Key="IconCell">
            <Grid Width="28" Height="28">
                <Border CornerRadius="8" Background="{StaticResource Surface2}"
                        Visibility="{Binding Image, Converter={StaticResource NotNullCollapsed}}">
                    <ui:Glyph Icon="{Binding Icon}" Width="18" Height="18" Foreground="{StaticResource Muted}" />
                </Border>
                <Image Source="{Binding Image}" Width="24" Height="24"
                       Visibility="{Binding Image, Converter={StaticResource NullCollapsed}}" />
            </Grid>
        </DataTemplate>

        <!-- One app or group in the preset editor -->
        <DataTemplate x:Key="ItemRowTemplate">
            <Border Padding="12,0" MinHeight="48" CornerRadius="8" Margin="0,1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource Surface2}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource IconCell}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" Visibility="{Binding Subtitle, Converter={StaticResource NullCollapsed}}" />
                    </StackPanel>
                    <Grid Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Center" MinWidth="92">
                        <ToggleButton Style="{StaticResource Pill}" IsChecked="{Binding Keep}"
                                      Visibility="{Binding KeptByGroupHint, Converter={StaticResource NotNullCollapsed}}"
                                      ToolTip="Не закрывать при включении пресета">
                            <StackPanel Orientation="Horizontal">
                                <ui:Glyph Icon="check" Width="14" Height="14" Margin="0,0,6,0" />
                                <TextBlock Text="Оставить" />
                            </StackPanel>
                        </ToggleButton>
                        <TextBlock Text="в группе" Style="{StaticResource Hint}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Visibility="{Binding KeptByGroupHint, Converter={StaticResource NullCollapsed}}"
                                   ToolTip="{Binding KeptByGroupHint}" />
                    </Grid>
                    <ToggleButton Grid.Column="3" Style="{StaticResource Pill}" IsChecked="{Binding Launch}"
                                  IsEnabled="{Binding CanLaunch}" VerticalAlignment="Center"
                                  ToolTip="Запустить, если не запущено">
                        <StackPanel Orientation="Horizontal">
                            <ui:Glyph Icon="play" Width="14" Height="14" Margin="0,0,6,0" />
                            <TextBlock Text="Запустить" />
                        </StackPanel>
                    </ToggleButton>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Margin="24,16,24,12">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <Image Source="/Assets/app.ico" Width="24" Height="24" />
                <TextBlock Text="Environments" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold"
                           Margin="10,0,24,0" VerticalAlignment="Center" />
                <RadioButton x:Name="TabPresets" Style="{StaticResource NavTab}" Content="Пресеты" IsChecked="True" Checked="Tab_Checked" />
                <RadioButton x:Name="TabApps" Style="{StaticResource NavTab}" Content="Приложения" Checked="Tab_Checked" />
                <RadioButton x:Name="TabGroups" Style="{StaticResource NavTab}" Content="Группы" Checked="Tab_Checked" />
                <RadioButton x:Name="TabSettings" Style="{StaticResource NavTab}" Content="Настройки" Checked="Tab_Checked" />
            </StackPanel>
            <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Click="Undo_Click"
                    ToolTip="Запустить снова то, что закрыл последний пресет">
                <StackPanel Orientation="Horizontal">
                    <ui:Glyph Icon="undo" Margin="0,0,8,0" />
                    <TextBlock Text="Вернуть как было" />
                </StackPanel>
            </Button>
        </DockPanel>

        <!-- ===== Presets ===== -->
        <Grid x:Name="PagePresets" Grid.Row="1" Margin="24,0,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="8">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch"
                            Click="NewPreset_Click" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:Glyph Icon="plus" Margin="0,0,8,0" />
                            <TextBlock Text="Новый пресет" />
                        </StackPanel>
                    </Button>
                    <ListBox x:Name="PresetList" SelectionChanged="PresetList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="28" Height="28" CornerRadius="8"
                                            Background="{Binding Color, Converter={StaticResource HexBrush}}">
                                        <ui:Glyph Icon="{Binding Icon}" Foreground="{StaticResource OnPreset}" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="12,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Hotkey}" Style="{StaticResource HotkeyText}"
                                               VerticalAlignment="Center" Margin="0,0,4,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid x:Name="PresetEditor">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Editor header -->
                    <Grid Margin="24,24,24,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PresetBadge" Width="56" Height="56" Padding="0" BorderThickness="0"
                                Click="PresetIcon_Click" ToolTip="Сменить значок" AutomationProperties.Name="Значок пресета">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="14">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <ui:Glyph x:Name="PresetGlyph" Width="28" Height="28" Foreground="{StaticResource OnPreset}" />
                        </Button>
                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                            <TextBox x:Name="PresetName" Style="{StaticResource InlineBox}" FontFamily="{StaticResource DisplayFont}"
                                     FontSize="22" FontWeight="SemiBold" TextChanged="PresetField_Changed" />
                            <ItemsControl x:Name="Swatches" Margin="4,6,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="18" Height="18" MinHeight="0" Margin="0,0,8,0" Padding="0" Tag="{Binding}" Click="Swatch_Click"
                                                Background="{Binding Converter={StaticResource HexBrush}}" BorderThickness="0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="999" />
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource GhostButton}" Click="DuplicatePreset_Click" ToolTip="Копия" AutomationProperties.Name="Копия">
                                <ui:Glyph Icon="copy" />
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Click="ExportPreset_Click" ToolTip="Экспорт в файл" AutomationProperties.Name="Экспорт в файл">
                                <ui:Glyph Icon="export" />
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Click="ImportPreset_Click" ToolTip="Импорт из файла" AutomationProperties.Name="Импорт из файла">
                                <ui:Glyph Icon="import" />
                            </Button>
                            <Button Style="{StaticResource DangerButton}" Click="DeletePreset_Click" ToolTip="Удалить пресет" AutomationProperties.Name="Удалить пресет">
                                <ui:Glyph Icon="trash" />
                            </Button>
                            <Button x:Name="RunButton" Style="{StaticResource AccentButton}" Margin="12,0,0,0" Padding="18,0"
                                    Height="36" Click="RunPreset_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ui:Glyph Icon="play" Margin="0,0,8,0" />
                                    <TextBlock Text="Включить" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24,8,24,24">
                            <DockPanel Margin="0,16,0,0">
                                <Button DockPanel.Dock="Right" Click="AddFromRunning_Click" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:Glyph Icon="plus" Margin="0,0,8,0" />
                                        <TextBlock Text="Из запущенных" />
                                    </StackPanel>
                                </Button>
                                <Grid DockPanel.Dock="Right" Width="220" Margin="16,0,8,0" VerticalAlignment="Center">
                                    <TextBox x:Name="Search" Padding="34,0,10,0" TextChanged="Search_Changed" />
                                    <ui:Glyph Icon="search" Margin="10,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"
                                              Foreground="{StaticResource Muted}" />
                                    <TextBlock x:Name="SearchPlaceholder" Text="Поиск" Style="{StaticResource Hint}" Margin="36,0,0,0"
                                               VerticalAlignment="Center" IsHitTestVisible="False" />
                                </Grid>
                                <TextBlock Style="{StaticResource H2}" Margin="0" Text="Что оставить и что запустить"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                       Text="Всё, что не отмечено «Оставить», закроется. «Запустить» откроет программу, если она не запущена." />

                            <TextBlock Style="{StaticResource Label}" Text="ГРУППЫ" />
                            <ItemsControl x:Name="GroupRows" ItemTemplate="{StaticResource ItemRowTemplate}" />
                            <TextBlock Style="{StaticResource Label}" Text="ПРИЛОЖЕНИЯ" />
                            <ItemsControl x:Name="AppRows" ItemTemplate="{StaticResource ItemRowTemplate}" />

                            <TextBlock Style="{StaticResource H2}" Text="Как закрывать" />
                            <UniformGrid Columns="3" Margin="0,8,0,0">
                                <RadioButton x:Name="ModeGentle" Style="{StaticResource ChoiceCard}" GroupName="mode" Checked="Mode_Checked">
                                    <StackPanel>
                                        <TextBlock Text="Аккуратно" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                                   Text="Только просит окна закрыться. То, что прячется в трей, останется в трее." />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="ModeSmart" Style="{StaticResource ChoiceCard}" GroupName="mode" Checked="Mode_Checked">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold">
                                            <Run Text="Умно" /><Run Text=" · по умолчанию" Foreground="{StaticResource Accent}" FontWeight="Normal" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                                   Text="Добивает то, что ушло в трей. Окна с вопросом «сохранить?» не трогает." />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="ModeForce" Style="{StaticResource DangerChoiceCard}" GroupName="mode" Checked="Mode_Checked" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="Жёстко" FontWeight="SemiBold" Foreground="{StaticResource Danger}" />
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                                   Text="Убивает всё, что не закрылось. Несохранённое пропадёт." />
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>

                            <WrapPanel Margin="0,16,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,24,8">
                                    <TextBlock Text="Ждать закрытия" VerticalAlignment="Center" />
                                    <TextBox x:Name="WaitSeconds" Width="52" Margin="8,0" TextChanged="PresetField_Changed"
                                             HorizontalContentAlignment="Center" />
                                    <TextBlock Text="сек" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,24,8">
                                    <TextBlock Text="Горячая клавиша" VerticalAlignment="Center" />
                                    <Grid Width="170" Margin="8,0,4,0">
                                        <TextBox x:Name="HotkeyBox" IsReadOnly="True" IsReadOnlyCaretVisible="False" Padding="34,0,10,0"
                                                 FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="Medium"
                                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotKeyboardFocus="HotkeyBox_GotFocus"
                                                 LostKeyboardFocus="HotkeyBox_LostFocus" ToolTip="Кликни и нажми сочетание" />
                                        <ui:Glyph Icon="keyboard" Margin="10,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"
                                                  Foreground="{StaticResource Muted}" />
                                    </Grid>
                                    <Button Style="{StaticResource GhostButton}" Padding="8,0" Click="ClearHotkey_Click" ToolTip="Убрать" AutomationProperties.Name="Убрать">
                                        <ui:Glyph Icon="close" />
                                    </Button>
                                </StackPanel>
                            </WrapPanel>
                            <Border x:Name="HotkeyWarningBox" Style="{StaticResource WarningStrip}" Margin="0,0,0,8"
                                    HorizontalAlignment="Left" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <ui:Glyph Icon="warning" Margin="0,0,8,0" />
                                    <TextBlock x:Name="HotkeyWarning" FontSize="12.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <CheckBox x:Name="NewDesktopBox" Margin="0,8,0,0" Checked="PresetCheck_Changed" Unchecked="PresetCheck_Changed">
                                <StackPanel>
                                    <TextBlock Text="Открывать на новом рабочем столе" />
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Создаёт отдельный рабочий стол и запускает нужное там. Старый стол остаётся как есть, ничего не закрывается." />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox x:Name="MinimizeBox" Margin="0,12,0,0" Checked="PresetCheck_Changed" Unchecked="PresetCheck_Changed"
                                      Content="Сворачивать вместо закрытия" />
                            <CheckBox x:Name="BackgroundBox" Margin="0,12,0,0" Checked="PresetCheck_Changed" Unchecked="PresetCheck_Changed"
                                      Content="Закрывать и фоновые программы (без окна, в трее)" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== Apps ===== -->
        <Grid x:Name="PageApps" Grid.Row="1" Margin="24,0,24,24" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button Style="{StaticResource GhostButton}" Click="AppsAddFromRunning_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:Glyph Icon="plus" Margin="0,0,8,0" />
                                <TextBlock Text="Из запущенных" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Content="Пустое приложение" Click="NewApp_Click" />
                    </StackPanel>
                    <ListBox x:Name="AppList" SelectionChanged="AppList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource IconCell}" />
                                    <TextBlock Text="{Binding Title}" Margin="12,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="AppEditor">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Click="DeleteApp_Click" ToolTip="Удалить из списка" AutomationProperties.Name="Удалить из списка">
                                <ui:Glyph Icon="trash" />
                            </Button>
                            <Button DockPanel.Dock="Right" Click="TestLaunch_Click" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:Glyph Icon="play" Margin="0,0,8,0" />
                                    <TextBlock Text="Проверить запуск" />
                                </StackPanel>
                            </Button>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="AppIconButton" Width="40" Height="40" Padding="0" Click="AppIcon_Click"
                                        ToolTip="Значок, если у программы нет своей иконки" AutomationProperties.Name="Значок приложения">
                                    <ui:Glyph x:Name="AppGlyph" Width="22" Height="22" />
                                </Button>
                                <TextBox x:Name="AppName" Width="300" Margin="12,0,0,0" FontSize="16" FontWeight="SemiBold"
                                         LostFocus="AppField_LostFocus" />
                            </StackPanel>
                        </DockPanel>

                        <TextBlock Style="{StaticResource H2}" Text="Как узнать программу" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="По строке на правило. process: имя exe (можно *), path: кусок пути, title: кусок заголовка окна. Пример: process:Discord" />
                        <TextBox x:Name="AppRules" Style="{StaticResource CodeBox}" MinHeight="96" Margin="0,8,0,0"
                                 LostFocus="AppField_LostFocus" />

                        <TextBlock Style="{StaticResource H2}" Text="Как запускать" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="По строке на вариант, пробуются по очереди. Путь к exe (можно %APPDATA% и *) или ссылка вроде steam://open/main. Аргументы — после « | »." />
                        <TextBox x:Name="AppLaunch" Style="{StaticResource CodeBox}" MinHeight="76" Margin="0,8,0,0"
                                 LostFocus="AppField_LostFocus" />
                        <TextBlock x:Name="AppLaunchStatus" Style="{StaticResource Hint}" Margin="0,8,0,0" />

                        <TextBlock Style="{StaticResource H2}" Text="В группах" />
                        <TextBlock x:Name="AppGroupsText" Style="{StaticResource Hint}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ===== Groups ===== -->
        <Grid x:Name="PageGroups" Grid.Row="1" Margin="24,0,24,24" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="8">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource GhostButton}" Click="NewGroup_Click" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:Glyph Icon="plus" Margin="0,0,8,0" />
                            <TextBlock Text="Новая группа" />
                        </StackPanel>
                    </Button>
                    <ListBox x:Name="GroupList" SelectionChanged="GroupList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource Surface2}">
                                        <ui:Glyph Icon="{Binding Icon}" Width="18" Height="18" Foreground="{StaticResource Muted}" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}" Margin="12,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="24">
                <DockPanel x:Name="GroupEditor">
                    <DockPanel DockPanel.Dock="Top">
                        <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Click="DeleteGroup_Click" ToolTip="Удалить группу" AutomationProperties.Name="Удалить группу">
                            <ui:Glyph Icon="trash" />
                        </Button>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="GroupIconButton" Width="40" Height="40" Padding="0" Click="GroupIcon_Click" ToolTip="Сменить значок" AutomationProperties.Name="Сменить значок">
                                <ui:Glyph x:Name="GroupGlyph" Width="22" Height="22" />
                            </Button>
                            <TextBox x:Name="GroupName" Width="300" Margin="12,0,0,0" FontSize="16" FontWeight="SemiBold"
                                     LostFocus="GroupField_LostFocus" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource H2}" Text="Что входит" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="GroupMembers">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Checked}" Margin="0,4">
                                        <StackPanel Orientation="Horizontal">
                                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource IconCell}" />
                                            <TextBlock Text="{Binding Title}" Margin="10,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===== Settings ===== -->
        <Border x:Name="PageSettings" Grid.Row="1" Margin="24,0,24,24" Style="{StaticResource Card}" Padding="24" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                    <CheckBox x:Name="AutostartBox" Content="Запускать вместе с Windows (тихо, в трей)"
                              Checked="Setting_Changed" Unchecked="Setting_Changed" />
                    <CheckBox x:Name="HotkeyPreviewBox" Margin="0,12,0,0"
                              Content="Горячая клавиша и трей сначала показывают, что закроется"
                              Checked="Setting_Changed" Unchecked="Setting_Changed" />
                    <CheckBox x:Name="NotificationsBox" Margin="0,12,0,0" Content="Уведомление с итогом после пресета"
                              Checked="Setting_Changed" Unchecked="Setting_Changed" />

                    <StackPanel Orientation="Horizontal" Margin="0,24,0,4">
                        <ui:Glyph Icon="shield" Width="18" Height="18" Margin="0,0,8,0" Foreground="{StaticResource Muted}" />
                        <TextBlock Style="{StaticResource H2}" Margin="0" Text="Никогда не закрывать" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Защищено во всех пресетах: система, проводник, драйверы, оверлеи, терминалы. Правила как у приложений, по строке." />
                    <TextBox x:Name="ProtectedBox" Style="{StaticResource CodeBox}" MinHeight="200" Margin="0,8,0,0"
                             LostFocus="Protected_LostFocus" />

                    <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                        <Button Click="OpenData_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:Glyph Icon="folder" Margin="0,0,8,0" />
                                <TextBlock Text="Открыть папку с настройками" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DangerButton}" Content="Сбросить всё к встроенному" Margin="8,0,0,0" Click="Reset_Click" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
