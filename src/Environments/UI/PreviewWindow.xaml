<Window x:Class="Environments.UI.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Environments.UI"
        Title="Environments" Width="560" Height="640" MinHeight="400" WindowStartupLocation="CenterScreen"
        Style="{StaticResource WindowBase}" Icon="/Assets/app.ico" Topmost="True" ShowInTaskbar="True">
    <Window.Resources>
        <ui:PathToIconConverter x:Key="PathIcon" />
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Border x:Name="Badge" Width="44" Height="44" CornerRadius="12">
                <ui:Glyph x:Name="BadgeIcon" Width="22" Height="22" Foreground="{StaticResource OnPreset}" />
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="Header" Style="{StaticResource H1}" />
                <TextBlock x:Name="SubHeader" Style="{StaticResource Hint}" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <DockPanel>
                    <Button x:Name="ToggleAll" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="6,2"
                            Content="Снять все" Click="ToggleAll_Click" />
                    <TextBlock x:Name="CloseTitle" Style="{StaticResource H2}" Margin="0" />
                </DockPanel>
                <ItemsControl x:Name="CloseList" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Selected}" Margin="0,5">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding App.Path, Converter={StaticResource PathIcon}}" Width="20" Height="20" />
                                    <StackPanel Margin="10,0,0,0">
                                        <TextBlock Text="{Binding DisplayName}" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Hint}" MaxWidth="380"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    </StackPanel>
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="NothingToClose" Style="{StaticResource Hint}" Text="Закрывать нечего." Visibility="Collapsed" />

                <TextBlock Style="{StaticResource H2}" Text="Останется" />
                <TextBlock x:Name="KeptText" Style="{StaticResource Hint}" />

                <TextBlock x:Name="LaunchTitle" Style="{StaticResource H2}" Text="Запустится" />
                <TextBlock x:Name="LaunchText" Style="{StaticResource Hint}" />
            </StackPanel>
        </ScrollViewer>

        <Border x:Name="ResultBox" Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock x:Name="ResultText" TextWrapping="Wrap" />
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="UndoButton" Visibility="Collapsed" Click="Undo_Click" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <ui:Glyph Icon="undo" Margin="0,0,8,0" />
                    <TextBlock Text="Вернуть как было" />
                </StackPanel>
            </Button>
            <Button x:Name="CancelButton" Content="Отмена" Click="Cancel_Click" Margin="0,0,8,0" />
            <Button x:Name="ApplyButton" Style="{StaticResource AccentButton}" Content="Включить" Padding="22,0" Height="36" Click="Apply_Click"
                    IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
