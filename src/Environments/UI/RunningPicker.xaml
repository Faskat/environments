<Window x:Class="Environments.UI.RunningPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Environments.UI"
        Title="Из запущенных" Width="520" Height="560" WindowStartupLocation="CenterOwner"
        Style="{StaticResource WindowBase}" ShowInTaskbar="False">
    <Window.Resources>
        <ui:PathToIconConverter x:Key="PathIcon" />
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Style="{StaticResource H1}" Text="Что сейчас открыто" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                       Text="Отметь программы — они попадут в список приложений и в «Оставить» текущего пресета." />
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="List">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding Selected}" Margin="0,5">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding App.Path, Converter={StaticResource PathIcon}}" Width="24" Height="24" />
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Text="{Binding DisplayName}" />
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Hint}" MaxWidth="360"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </StackPanel>
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" IsCancel="True" Margin="0,0,8,0" />
            <Button Style="{StaticResource AccentButton}" Content="Добавить" IsDefault="True" Click="Ok_Click" />
        </StackPanel>
    </Grid>
</Window>
